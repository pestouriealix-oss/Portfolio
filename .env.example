# URL publique du site, sans slash final. Sert aux URLs canoniques, au sitemap et à security.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Formulaire de contact : clé API Resend (https://resend.com). SECRET, serveur uniquement.
# Sans cette clé, le formulaire affiche un message invitant à écrire par e-mail.
RESEND_API_KEY=
# Facultatif. Destinataire des messages (par défaut : l'e-mail de src/config/site.ts).
# CONTACT_TO=
# Facultatif. Expéditeur, à définir une fois un domaine vérifié chez Resend.
# CONTACT_FROM="Portfolio <contact@mon-domaine.fr>"
