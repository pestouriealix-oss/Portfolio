  "journeys": [
    {
      "id": "draft-sheet",
      "name": "Le coach de draft écrit sa fiche",
      "steps": [
        {
          "node": "web",
          "text": "Le joueur remplit la draft (ou elle se remplit seule depuis la partie en cours) et demande la fiche."
        },
        {
          "node": "api",
          "text": "Le navigateur appelle le serveur, qui vérifie la connexion et le quota du jour."
        },
        {
          "node": "coach",
          "text": "Le coach rassemble les faits : sorts des champions, taux de victoire du duel, duel déjà écrit pour d'autres joueurs."
        },
        {
          "node": "game",
          "text": "Les statistiques de matchups, comptées à partir de vraies parties classées, sont jointes."
        },
        {
          "node": "coach",
          "text": "Deux demandes partent en même temps à Claude : conditions de victoire et duel."
        },
        {
          "node": "anthropic",
          "text": "Claude écrit la fiche, renvoyée morceau par morceau à l'écran."
        },
        {
          "node": "data",
          "text": "La fiche, le duel et le coût de l'appel sont enregistrés."
        }
      ]
    },
    {
      "id": "sync-review",
      "name": "Synchroniser puis analyser une partie",
      "steps": [
        {
          "node": "web",
          "text": "Sur le tableau de bord, le joueur clique « Mettre à jour »."
        },
        {
          "node": "game",
          "text": "Le site va chercher les nouvelles parties du compte."
        },
        {
          "node": "riot",
          "text": "Riot renvoie l'historique, le détail et la chronologie de chaque partie."
        },
        {
          "node": "data",
          "text": "Les parties sont enregistrées en base."
        },
        {
          "node": "api",
          "text": "Sur la page d'une partie, « Écrire mon bilan » demande l'analyse."
        },
        {
          "node": "coach",
          "text": "Seuls des faits calculés (écarts à 10 et 15 min, morts, objectifs) sont donnés au modèle."
        },
        {
          "node": "anthropic",
          "text": "Claude écrit ce qui a marché, ce qui a coûté et comment progresser."
        }
      ]
    },
    {
      "id": "premium",
      "name": "Passer en Premium",
      "steps": [
        {
          "node": "web",
          "text": "Le joueur clique sur le bouton de paiement de la page Premium."
        },
        {
          "node": "paddle",
          "text": "Paddle affiche le paiement et encaisse ; le site ne voit jamais la carte."
        },
        {
          "node": "api",
          "text": "Paddle prévient le site ; la signature de la notification est vérifiée."
        },
        {
          "node": "account",
          "text": "L'abonnement est interprété : actif, résilié, fin de période."
        },
        {
          "node": "data",
          "text": "L'utilisateur passe en Premium dans la base."
        }
      ]
    }
  ]
}
